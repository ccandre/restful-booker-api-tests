    {
      "name": "Create New Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst result = pm.response.json();\r\n\r\npm.test(\"Response booking matches input\", function () {\r\n    const requestBody = JSON.parse(pm.request.body.raw);\r\n\r\n    pm.expect(result.booking.firstname).to.eql(requestBody.firstname);\r\n    pm.expect(result.booking.lastname).to.eql(requestBody.lastname);\r\n    pm.expect(result.booking.totalprice).to.eql(requestBody.totalprice);\r\n    pm.expect(result.booking.depositpaid).to.eql(requestBody.depositpaid);\r\n    pm.expect(result.booking.bookingdates.checkin).to.eql(requestBody.bookingdates.checkin);\r\n    pm.expect(result.booking.bookingdates.checkout).to.eql(requestBody.bookingdates.checkout);\r\n    pm.expect(result.booking.additionalneeds).to.eql(requestBody.additionalneeds);\r\n});\r\n\r\npm.test('JSON schema is valid', function () {\r\n  const schema = {\r\n    type: 'object',\r\n    required: ['bookingid', 'booking'],\r\n    properties: {\r\n      bookingid: { type: 'number' },\r\n      booking: {\r\n        type: 'object',\r\n        required: ['firstname','lastname','totalprice','depositpaid','bookingdates'],\r\n        properties: {\r\n          firstname: { type: 'string' },\r\n          lastname: { type: 'string' },\r\n          totalprice: { type: 'number' },\r\n          depositpaid: { type: 'boolean' },\r\n          bookingdates: {\r\n            type: 'object',\r\n            required: ['checkin','checkout'],\r\n            properties: { checkin: { type: 'string' }, checkout: { type: 'string' } }\r\n          }\r\n        }\r\n      }\r\n    }\r\n  };\r\n  pm.response.to.have.jsonSchema(schema);\r\n});\r\n\r\npm.collectionVariables.set(\"bookingId\", (result.bookingid));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"firstname\" : \"Andre\",\r\n    \"lastname\" : \"Marin\",\r\n    \"totalprice\" : 200,\r\n    \"depositpaid\" : true,\r\n    \"bookingdates\" : {\r\n        \"checkin\" : \"2018-01-01\",\r\n        \"checkout\" : \"2019-01-01\"\r\n    },\r\n    \"additionalneeds\" : \"Breakfast\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/booking",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "booking"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Update Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\nconst result = pm.response.json();\r\n\r\npm.test(\"Response booking matches input\", function () {\r\n    const requestBody = JSON.parse(pm.request.body.raw);\r\n\r\n    pm.expect(result.firstname).to.eql(requestBody.firstname);\r\n    pm.expect(result.lastname).to.eql(requestBody.lastname);\r\n    pm.expect(result.totalprice).to.eql(requestBody.totalprice);\r\n    pm.expect(result.depositpaid).to.eql(requestBody.depositpaid);\r\n    pm.expect(result.bookingdates.checkin).to.eql(requestBody.bookingdates.checkin);\r\n    pm.expect(result.bookingdates.checkout).to.eql(requestBody.bookingdates.checkout);\r\n    pm.expect(result.additionalneeds).to.eql(requestBody.additionalneeds);\r\n});\r\n"
            ]
          }
        }
      ],
